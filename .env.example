# S&S Cafe - Firebase Cloud Database Configuration
# Inhe Netlify Dashboard me: Site Settings > Environment variables me add karein
# ya Local testing ke liye `.env` file me paste karein:

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=my-cafe-project-id
VITE_FIREBASE_AUTH_DOMAIN=my-cafe-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=my-cafe-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
